  "riskGates": {
    "read_only": {
      "gate": "project-scoped read-only",
      "references": [],
      "scripts": []
    },
    "local_artifact_write": {
      "gate": "explicit external output or private knowledge root",
      "references": [
        "knowledge-card.schema.json"
      ],
      "scripts": [
        "ks_knowledge.py"
      ]
    },
    "project_write": {
      "gate": "dry run plus exact project-scoped approval",
      "references": [
        "safe-writes.md",
        "safe-patch-workflow.md"
      ],
      "scripts": [
        "ks_safe_patch_lint.py",
        "ks_safe_patch_execute.py"
      ]
    },
    "external_or_runtime": {
      "gate": "exact runtime operation approval plus verification",
      "references": [
        "safe-patch-workflow.md"
      ],
      "scripts": [
        "ks_approved_runtime_execute.py"
      ]
    },
    "destructive_or_global": {
      "gate": "separate target-specific destructive approval",
      "references": [
        "safe-patch-workflow.md",
        "backups-zstd.md"
      ],
      "scripts": [
        "ks_safe_patch_lint.py"
      ]
    },
    "server_or_db": {
      "gate": "explicit server-maintenance approval",
      "references": [],
      "scripts": []
    }
