{
  "format": "teamvalue.ks-capability-scenarios",
  "formatVersion": "1.0",
  "cases": [
    {
      "id": "six-area-runtime-chain",
      "purpose": "Trace an integration-to-iframe failure without limiting the causal chain.",
      "request": {
        "format": "teamvalue.ks-capability-request",
        "formatVersion": "1.0",
        "mode": "coordinated",
        "phase": "runtime",
        "capabilities": [
          {"id": "integrations", "operation": "run"},
          {"id": "model-data", "operation": "inspect"},
          {"id": "indicators-formulas", "operation": "inspect"},
          {"id": "tables", "operation": "inspect"},
          {"id": "dashboard-ui", "operation": "inspect"},
          {"id": "browser-diagnostics", "operation": "inspect"}
        ],
        "verification": ["api-readback", "browser"],
        "knowledge": {"search": true, "captureCandidate": false}
      },
      "expected": {
        "effectiveRisk": "external_or_runtime",
        "directCapabilities": [
          "integrations.run",
          "model-data.inspect",
          "indicators-formulas.inspect",
          "tables.inspect",
          "dashboard-ui.inspect",
          "browser-diagnostics.inspect"
        ],
        "includedAreas": [
          "environment-project",
          "integrations",
          "model-data",
          "indicators-formulas",
          "tables",
          "dashboard-ui",
          "browser-diagnostics"
        ],
        "phaseIds": [
          "retrieve-private-evidence",
          "read-current-state",
          "cross-area-synthesis",
          "approval-boundary",
          "prepare-integrations-run",
          "verification"
        ]
      }
    },
    {
